class Solution {
    public List<Integer> findMissingElements(int[] nums) {
        int n = nums.length;
        Arrays.sort(nums);
        int min = nums[0];
        int max = nums[n-1];
        
        List<Integer> ans = new ArrayList<>();
        Set<Integer> set = new HashSet<>();
        for( int num : nums){
            set.add(num);
        }
        for(int i = min ; i<= max ; i++ ){
           if( !set.contains(i)){
            ans.add(i);
        }
        }
        return ans;
    }
}
