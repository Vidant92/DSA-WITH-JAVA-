class Solution {
    public int nearestDrone(int[][] drones, int[] target) {
        int index = -1;
        int best = Integer.MAX_VALUE;

        for(int i= 0; i< drones.length;i++){
            int a = drones[i][0];
            int b = drones[i][1];
            int r = drones[i][2];

            int d = Math.abs(a - target[0]) + Math.abs(b - target[1]);

            if(d <= r && d < best){
                best = d;
                index = i;
            }
        }
        return index;
    }
}
