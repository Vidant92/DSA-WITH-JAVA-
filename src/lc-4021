class Solution {
    public int minOperations(String s) {
        int n = s.length();
        int ans = Integer.MAX_VALUE;

        for(int r = 0; r < n; r++){
            int cost = r; // r left rotations honge
            for(int i= 0; i< n / 2; i++){
                int j = n - 1 - i;

                char a = s.charAt((i + r) % n);
                char b = s.charAt((j + r) % n);

                int diff = Math.abs(a - b);
                cost += Math.min(diff, 26 - diff);
            }
            ans = Math.min(ans, cost);
        }
        return ans;
    }
}
