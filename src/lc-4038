class Solution {
    public int countSpecialIntegers(int[] nums) {
        boolean[] seen = new boolean[101];
        boolean[] bad = new boolean[101];

        for(int i = 0; i < nums.length; i++){
            if (i == 0 || nums[i] != nums[i - 1]) {
                int x = nums[i];

                if(seen[x]){
                    bad[x] = true;
                }
                seen[x] = true;
            }
        }

        int ans = 0;
        for(int x = 1; x <= 100; x++){
            if (seen[x] && !bad[x]) {
                ans++;
            }
        }
        return ans;
    }
}
