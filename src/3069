class Solution {
    public int[] resultArray(int[] nums){
        int n = nums.length;
        int[] arr1 = new int[n];
        int[] arr2 = new int[n];

        int j=0;
        int k =0;
        for(int i =0; i<n;i++){
            if( i==0){
                arr1[j] =nums[i];
                j++;
            }
            else if( i ==1){
                arr2[k] = nums[i];
                k++;
            }
            else{
                if(arr1[j-1] > arr2[k-1]){
                arr1[j]= nums[i];
                j++;
                }
                else{
                    arr2[k]= nums[i];
                    k++;
                }
            }
        }
        for(int i =0; i<k;i++){
            arr1[j] = arr2[i];
            j++;
        }
        return arr1;
    }
}
