class Solution {
    public int longestOnes(int[] nums, int k){
        int low = 0;
        int maxlen = 0;
        int zerocount = 0;
        int high =0;
        for( high = 0; high <nums.length;high++){
            if(nums[high ] == 0){
                zerocount++;
            }
        
        while(zerocount > k){
            if(nums[low] == 0){
                zerocount--;
            }
            low++;
        }
        int len = high-low +1;
        maxlen = Math.max(maxlen,len);
        }
        return maxlen;
    }
}
